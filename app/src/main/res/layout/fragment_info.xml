<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".presentation.mvvm.ui.fragment.InfoFragment">
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/short1"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/imgPlace"
        android:layout_width="@dimen/medium2"
        android:layout_height="@dimen/medium2"
        android:layout_gravity="center"
        android:contentDescription="@string/image_fragment_info"
        tools:ignore="ImageContrastCheck"
        tools:srcCompat="@tools:sample/avatars" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/short1"
        android:layout_weight="0.25" />

    <TextView
        android:id="@+id/txtDescriptionPlace"
        android:layout_width="@dimen/medium2"
        android:layout_height="@dimen/medium1"
        tools:text="Descripción del lugar"
        style="@style/MiParrafoStyle" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/short1"
        android:layout_weight="1" />
</LinearLayout>