<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/startFragment">

    <fragment
        android:id="@+id/startFragment"
        android:name="com.yjotdev.zonasturisticaselguabo.presentation.mvvm.ui.fragment.StartFragment"
        android:label="@string/txt_fragment_start"
        tools:layout="@layout/fragment_start">
        <action
            android:id="@+id/action_start_to_map"
            app:destination="@id/mapFragment" />
        <action
            android:id="@+id/action_start_to_map_fake"
            app:destination="@id/mapFakeFragment" />
    </fragment>

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.yjotdev.zonasturisticaselguabo.presentation.mvvm.ui.fragment.MapFragment"
        android:label="@string/title_fragment_map"
        tools:layout="@layout/fragment_map">
        <action
            android:id="@+id/action_map_to_info"
            app:destination="@id/infoFragment" />
    </fragment>

    <fragment
        android:id="@+id/mapFakeFragment"
        android:name="com.yjotdev.zonasturisticaselguabo.presentation.mvvm.ui.fragment.MapFakeFragment"
        android:label="@string/title_fragment_map"
        tools:layout="@layout/fragment_map_fake">
        <action
            android:id="@+id/action_map_fake_to_info"
            app:destination="@id/infoFragment" />
    </fragment>

    <fragment
        android:id="@+id/infoFragment"
        android:name="com.yjotdev.zonasturisticaselguabo.presentation.mvvm.ui.fragment.InfoFragment"
        tools:layout="@layout/fragment_info">
    </fragment>

</navigation>